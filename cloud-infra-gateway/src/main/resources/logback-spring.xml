<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 自包含 logback 配置（不依赖 cloud-infra-common 的 include，避免 fat jar 嵌套资源无法加载） -->

    <!-- 标准控制台输出（开发环境人类可读） -->
    <appender name="CONSOLE_STD" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - [traceId=%X{traceId:-none} spanId=%X{spanId:-none}] - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- JSON 控制台输出（生产环境日志采集） -->
    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp/>
                <version/>
                <logLevel/>
                <threadName/>
                <loggerName/>
                <message/>
                <mdc/>
                <stackTrace/>
                <arguments/>
            </providers>
        </encoder>
    </appender>

    <!-- 按 Profile 选择输出格式 -->
    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE_STD"/>
        </root>
    </springProfile>

    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE_JSON"/>
        </root>
    </springProfile>

    <!-- 默认配置（无 profile 时的兜底） -->
    <root level="INFO">
        <appender-ref ref="CONSOLE_STD"/>
    </root>

    <!-- Spring Cloud Gateway MVC 调试日志 -->
    <logger name="org.springframework.cloud.gateway.server.mvc" level="DEBUG"/>
    <logger name="org.springframework.cloud.gateway.route" level="DEBUG"/>
    <logger name="org.springframework.cloud.gateway.handler" level="DEBUG"/>
    <logger name="org.springframework.web.servlet.DispatcherServlet" level="DEBUG"/>
    <logger name="org.springframework.web.reactive" level="DEBUG"/>
    <logger name="org.springframework.http.client" level="DEBUG"/>
    <!-- ⚠️ org.apache.hc.client5 不能开 DEBUG(2026-10-06 实测)。
         HttpClient5 的 wire logger 会把**整个 HTTP 报文逐字节**喂给
         ch.qos.logback 的 PatternLayout, 实测栈为:
           StreamUtils.copy → LoggingOutputStream.write → Wire.output
             → Wire.wire → Logger.debug → PatternLayout.doLayout
               → StringBuilder.append → Arrays.copyOf → OOM
         即每个 body 字节都被扩成一个 char(2B) 再加上 StringBuilder
         扩容时的多次数组拷贝, 实测约 37 倍放大。

         后果是**经网关上传超过 6MB 的文件必然打崩网关**
         (干净基线逐级实测: 4MB/6MB 成功, 7MB/8MB 必崩),
         日志仅一行 `java.lang.OutOfMemoryError: Java heap space`。

         ⚠️ 这里必须区分两个日志包 —— 它们完全不是一回事:
           org.apache.hc.client5.http.wire / .headers  = 逐字节报文日志, 必须关
           org.apache.hc.core5.http.wire                = 连接级摘要, 无害
         所以下面只关 client5 的 wire/headers, 不动 core5。 -->
    <logger name="org.apache.hc.client5.http.wire" level="INFO"/>
    <logger name="org.apache.hc.client5.http.headers" level="INFO"/>
    <logger name="org.apache.hc.core5" level="DEBUG"/>
    <logger name="org.springframework.cloud.client.loadbalancer" level="DEBUG"/>
    <logger name="org.springframework.retry" level="DEBUG"/>
    <logger name="org.springframework.cloud.gateway.server.mvc.filter" level="TRACE"/>
    <logger name="org.springframework.web.client" level="DEBUG"/>
</configuration>
