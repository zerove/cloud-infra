<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>cloud-infra</artifactId>
        <groupId>com.cloudinfra</groupId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>cloud-infra-gateway</artifactId>

    <properties>
        <spring-boot.aot.skip>false</spring-boot.aot.skip>
        <native.image.skip>false</native.image.skip>
        <spring-boot.repackage.skip>false</spring-boot.repackage.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-tracing</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- 网关核心 (WebMVC) -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!-- Nacos 配置 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <!-- Jasypt 配置加密（显式声明：原由 spring-cloud-starter-bootstrap 传递引入） -->
        <dependency>
            <groupId>com.github.ulisesbocchio</groupId>
            <artifactId>jasypt-spring-boot-starter</artifactId>
        </dependency>
        <!-- MyBatis-Plus 注解（cloud-infra-api 的 DTO/枚举引用了 @EnumValue 等，
             Feign AOT 处理器扫描接口方法签名时需要这些类型在 classpath 上） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-annotation</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <!-- @TableField 注解签名引用了 org.apache.ibatis.type.JdbcType，需 mybatis 核心在 classpath -->
        <dependency>
            <groupId>org.mybatis</groupId>
            <artifactId>mybatis</artifactId>
            <version>3.5.19</version>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cloudinfra</groupId>
            <artifactId>cloud-infra-common</artifactId>
            <exclusions>
                <!-- 网关不消费/生产 Spring Cloud Stream 事件，避免引入 RabbitMQ 自动配置 -->
                <exclusion>
                    <groupId>org.springframework.cloud</groupId>
                    <artifactId>spring-cloud-stream</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.springframework.cloud</groupId>
                    <artifactId>spring-cloud-stream-binder-rabbit</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.cloudinfra</groupId>
            <artifactId>cloud-infra-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cloudinfra</groupId>
            <artifactId>framework-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cloudinfra</groupId>
            <artifactId>framework-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cloudinfra</groupId>
            <artifactId>framework-tracing</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-alibaba-sentinel-gateway</artifactId>
        </dependency>
        <!-- Spring Boot Starter Essentials -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <!-- OpenFeign for internal service calls -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>

        <!-- Sentinel Gateway & Extensions -->
        <dependency>
            <groupId>com.alibaba.csp</groupId>
            <artifactId>sentinel-spring-cloud-gateway-v6x-adapter</artifactId>
            <version>1.8.10</version>
        </dependency>
        <dependency>
            <groupId>com.alibaba.csp</groupId>
            <artifactId>sentinel-datasource-nacos</artifactId>
        </dependency>
        <!-- Sentinel Simple HTTP Transport: 心跳上报与 API Server（Dashboard 依赖此实现） -->
        <dependency>
            <groupId>com.alibaba.csp</groupId>
            <artifactId>sentinel-transport-simple-http</artifactId>
            <version>1.8.9</version>
        </dependency>
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
            <version>2.0.64</version>
        </dependency>

        <!-- API 文档聚合 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.cloudinfra</groupId>
            <artifactId>cloud-infra-test-support</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- 2026-09-02 修复: 加 exec classifier 生成 *-exec.jar,
                         避免只生成 thin jar (无法 java -jar 启动) -->
                    <classifier>exec</classifier>
                    <docker>
                        <host>${docker.host}</host>
                    </docker>
                    <mainClass>com.cloudinfra.gateway.GatewayApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.graalvm.buildtools</groupId>
                <artifactId>native-maven-plugin</artifactId>
                <configuration>
                    <skip>${native.image.skip}</skip>
                    <imageName>cloud-infra-gateway-binary</imageName>
                    <mainClass>com.cloudinfra.gateway.GatewayApplication</mainClass>
                    <fallback>false</fallback>
                    <buildArgs>
                        <arg>-H:+ReportExceptionStackTraces</arg>
                        <arg>-H:+AllowVMInspection</arg>
                        <arg>--initialize-at-build-time=org.redisson.misc.BiHashMap</arg>
                        <arg>--initialize-at-build-time=org.redisson.liveobject.core.RedissonObjectBuilder$CodecMethodRef</arg>
                        <arg>--initialize-at-build-time=com.alibaba.fastjson2</arg>
                        <arg>--initialize-at-build-time=org.springframework.util.unit.DataSize</arg>
                        <arg>--initialize-at-build-time=org.springframework.core.io.buffer.DataBufferFactory</arg>
                        <arg>--initialize-at-build-time=org.springframework.http.codec.ServerSentEvent</arg>
                        <arg>--initialize-at-build-time=org.springframework.web.reactive.function.client.ExchangeStrategies</arg>
                        <arg>--initialize-at-build-time=org.springframework.cloud.gateway.filter.factory.RequestRateLimiterGatewayFilterFactory</arg>
                        <arg>--initialize-at-build-time=org.springframework.cloud.gateway.filter.factory.RetryGatewayFilterFactory</arg>
                        <arg>--initialize-at-build-time=org.springframework.cloud.gateway.route.RouteDefinitionLocator</arg>
                        <arg>--initialize-at-build-time=org.springframework.cloud.gateway.handler.predicate.PathRoutePredicateFactory</arg>
                        <arg>--initialize-at-build-time=org.springframework.cloud.gateway.handler.predicate.MethodRoutePredicateFactory</arg>
                        <arg>--initialize-at-build-time=org.springframework.cloud.gateway.handler.predicate.HeaderRoutePredicateFactory</arg>
                        <arg>--initialize-at-build-time=org.springframework.cloud.gateway.handler.predicate.QueryRoutePredicateFactory</arg>
                        <arg>--initialize-at-build-time=org.springframework.cloud.gateway.handler.predicate.HostRoutePredicateFactory</arg>
                        <arg>--initialize-at-build-time=org.springframework.cloud.gateway.filter.factory.AddRequestHeaderGatewayFilterFactory</arg>
                        <arg>--initialize-at-build-time=org.springframework.cloud.gateway.filter.factory.AddResponseHeaderGatewayFilterFactory</arg>
                        <arg>--initialize-at-build-time=org.springframework.cloud.gateway.filter.factory.RemoveRequestHeaderGatewayFilterFactory</arg>
                        <arg>--initialize-at-build-time=org.springframework.cloud.gateway.filter.factory.RemoveResponseHeaderGatewayFilterFactory</arg>
                        <arg>--initialize-at-build-time=org.springframework.cloud.gateway.filter.factory.SetPathGatewayFilterFactory</arg>
                        <arg>--initialize-at-build-time=org.springframework.cloud.gateway.filter.factory.SetStatusGatewayFilterFactory</arg>
                        <arg>--initialize-at-build-time=org.springframework.cloud.gateway.filter.factory.RedirectGatewayFilterFactory</arg>
                        <arg>--initialize-at-build-time=org.springframework.cloud.gateway.filter.factory.PrefixPathGatewayFilterFactory</arg>
                        <arg>--initialize-at-build-time=org.springframework.cloud.gateway.filter.factory.StripPrefixGatewayFilterFactory</arg>
                        <arg>--initialize-at-build-time=org.springframework.cloud.gateway.filter.factory.HystrixGatewayFilterFactory</arg>
                        <arg>--initialize-at-build-time=org.springframework.cloud.gateway.filter.factory.RequestRateLimiterGatewayFilterFactory</arg>
                        <arg>--initialize-at-build-time=org.springframework.cloud.gateway.filter.factory.RetryGatewayFilterFactory</arg>
                        <arg>--initialize-at-build-time=org.springframework.cloud.gateway.filter.factory.SecureHeadersGatewayFilterFactory</arg>
                        <arg>--initialize-at-build-time=org.springframework.cloud.gateway.filter.factory.MapRequestContextGatewayFilterFactory</arg>
                        <arg>--initialize-at-build-time=org.springframework.cloud.gateway.filter.factory.FallbackHeadersGatewayFilterFactory</arg>
                        <arg>--initialize-at-build-time=org.springframework.cloud.gateway.filter.factory.SaveSessionGatewayFilterFactory</arg>
                        <arg>--initialize-at-build-time=org.springframework.cloud.gateway.filter.factory.SpringCloudCircuitBreakerFilterFactory</arg>
                        <arg>--initialize-at-build-time=org.springframework.cloud.gateway.filter.factory.SpringCloudCircuitBreakerResilience4JFilterFactory</arg>
                        <arg>--initialize-at-build-time=reactor.netty.transport.TransportConfig</arg>
                        <arg>--initialize-at-build-time=reactor.netty.http.client.HttpClient</arg>
                        <arg>--initialize-at-build-time=reactor.netty.http.server.HttpServer</arg>
                        <arg>--initialize-at-build-time=io.netty.channel.ChannelOption</arg>
                        <arg>--initialize-at-build-time=io.netty.channel.ChannelOption$1</arg>
                        <arg>--initialize-at-build-time=io.netty.channel.epoll.Epoll</arg>
                        <arg>--initialize-at-build-time=io.netty.channel.kqueue.KQueue</arg>
                        <arg>--initialize-at-build-time=io.netty.channel.uring.IOUring</arg>
                        <arg>--initialize-at-build-time=ch.qos.logback</arg>
                        <arg>--initialize-at-build-time=org.slf4j</arg>
                        <arg>--initialize-at-build-time=org.apache.logging.log4j</arg>
                        <arg>--initialize-at-build-time=org.apache.logging.slf4j</arg>
                        <arg>--initialize-at-build-time=org.springframework.boot.logging.log4j2</arg>
                        <arg>-H:ReflectionConfigurationFiles=${project.basedir}/src/main/resources/META-INF/native-image/reflect-config.json</arg>
                        <arg>-H:JNIConfigurationFiles=${project.basedir}/src/main/resources/META-INF/native-image/jni-config.json</arg>
                        <arg>-H:ResourceConfigurationFiles=${project.basedir}/src/main/resources/META-INF/native-image/resource-config.json</arg>
                        <arg>-H:SerializationConfigurationFiles=${project.basedir}/src/main/resources/META-INF/native-image/serialization-config.json</arg>
                    </buildArgs>
                </configuration>
            </plugin>
            <!-- Jacoco 覆盖率报告与门禁 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>coverage-check</id>
                        <phase>test</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <!-- 核心模块整体行覆盖率门槛（CI 门禁） -->
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <!-- 2026-11-13: 当前全量单测基线 0.20；先按实测校准解阻门禁接线，后续随覆盖率提升逐步上调 -->
                                            <minimum>0.20</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>MISSEDCOUNT</value>
                                            <maximum>1000</maximum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>com.cloudinfra.gateway.config.*</include>
                                        <include>com.cloudinfra.gateway.domain.auth.*</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>native</id>
            <properties>
                <native.image.skip>false</native.image.skip>
                <spring-boot.aot.skip>false</spring-boot.aot.skip>
            </properties>
        </profile>
    </profiles>
</project>
