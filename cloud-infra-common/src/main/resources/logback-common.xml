<?xml version="1.0" encoding="UTF-8"?>
<included>
    <!-- Standard Console Appender for Human-Readable Logs (Dev) -->
    <appender name="CONSOLE_STD" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - [traceId=%X{traceId:-none} spanId=%X{spanId:-none}] - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- JSON Console Appender for Log Aggregators (Prod/Loki/ELK) -->
    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp/>
                <version/>
                <logLevel/>
                <threadName/>
                <loggerName/>
                <message/>
                <mdc/> <!-- This includes traceId and spanId automatically from MDC -->
                <stackTrace/>
                <arguments/>
            </providers>
        </encoder>
    </appender>

    <!-- Profile-based Root Logger Configuration -->
    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE_STD"/>
        </root>
    </springProfile>

    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE_JSON"/>
        </root>
    </springProfile>
</included>
