<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Cloud-Infra Checkstyle 规则（宽松基线）
  仅检查基本卫生规则，避免阻碍现有代码演进；
  命名、文档等规范由代码评审保证。
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="fileExtensions" value="java"/>

    <!-- 禁止 Tab 缩进（源码内） -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="false"/>
    </module>

    <!--
      放行 Spring Cloud Gateway 的 vendored 覆写类：
      该文件整份复制自上游 org.springframework.cloud.gateway，保留原始制表符缩进
      以便与上游 diff、便于后续升级替换。业务代码仍一律禁止 Tab。
    -->


    <!-- 行长度上限（宽松，为现有长行保留空间） -->
    <module name="LineLength">
        <property name="max" value="200"/>
        <property name="ignorePattern" value="^(import|package) "/>
    </module>

    <module name="TreeWalker">
        <!-- 排除生成的代码（gRPC/protobuf） -->
        <module name="SuppressionCommentFilter">
            <property name="onCommentFormat" value="Generated by the protocol buffer compiler"/>
            <property name="offCommentFormat" value="Generated by the protocol buffer compiler"/>
        </module>

        <!-- 禁止星号导入 -->
        <module name="AvoidStarImport"/>
        <!-- 禁止重复导入 -->
        <module name="RedundantImport"/>
        <!-- 禁止未使用导入 -->
        <module name="UnusedImports"/>

        <!-- 方法长度上限（宽松） -->
        <module name="MethodLength">
            <property name="max" value="200"/>
        </module>

        <!-- 单行单语句 -->
        <module name="OneStatementPerLine"/>

        <!-- 禁止一行声明多个变量 -->
        <module name="MultipleVariableDeclarations"/>

        <!-- 语句块必须带花括号 -->
        <module name="NeedBraces"/>

        <!-- 禁止空 catch 块（允许注释说明） -->
        <module name="EmptyBlock">
            <property name="option" value="text"/>
            <property name="tokens" value="LITERAL_CATCH"/>
        </module>
    </module>
</module>
