<?xml version="1.0" encoding="UTF-8"?>
<plugin>
  <name>cloud-infra-codegen-maven-plugin</name>
  <description>Cloud-Infra 代码生成 Maven 插件 - 集成到构建流程</description>
  <groupId>com.cloudinfra</groupId>
  <artifactId>cloud-infra-codegen-maven-plugin</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <goalPrefix>codegen</goalPrefix>
  <mojos>
    <mojo>
      <goal>generate</goal>
      <phase>generate-sources</phase>
      <threadSafe>true</threadSafe>
      <requiresProject>true</requiresProject>
      <implementation>com.cloudinfra.codegen.plugin.GenerateCodeMojo</implementation>
      <language>java</language>
    </mojo>
  </mojos>
</plugin>
