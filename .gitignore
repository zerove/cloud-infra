**/target/
**/target-*/
META-INF/
!**/src/**/META-INF/
*.bak
*.class
hs_err_pid*.log
# 误生成到仓库根目录的编译产物目录
/org/
/io/
cp.txt
# Deploy artifacts (local builds)
deploy/app.jar
.gradle/
.classpath
.project
.settings/
.idea/
.vscode/
.omg/
*.log
deploy_log.txt

# Ignore deployment/local infrastructure data
deploy/data/
deploy/nacos/
seata/
nacos-mysql.sql

# 本地环境变量与凭证（含默认口令，禁止入库）
.env
.env.local

# 清理临时跟踪文件
notification_api_tracker.md
search_service_tracker.md
task_tracker.md

# Ignore system files
.DS_Store
Thumbs.db

.worktrees/
.worktrees/

# Native Image build artifacts
**/target/native-build/
cp.txt
dependency-reduced-pom.xml
rebuild-native.sh
spring-aot-resources.jar
tools/
# CI quality-gate 引用的校验脚本必须入库（tools 其余文件仍本地忽略）
!tools/
tools/*
!tools/check-doc-versions.sh

# Agent runtime data (local only)
.omo/
.opencode/

# Benchmark results (local only)
benchmark-results/
benchmark-results-*/

# Local Maven settings override (fast mirror)
.mvn-settings-fast.xml

# K8s 真实密钥清单（占位模板 config-secrets.example.yaml 入库，真实值由 CI/运维注入）
deploy/k8s/infra/config-secrets.yaml

# 根目录杂项（会话产物/评审提示词，不入库）
/cp.txt
/code-quality-reviewer-prompt.md
/notification_api_tracker.md
/search_service_tracker.md
/spec-reviewer-prompt.md
/task_tracker.md

# Nacos 本地运行时数据与解包产物（compose 用镜像内置配置）
nacos/data/
nacos/logs/
nacos-mysql.sql

# 历史调试残留
hs_err_pid*.log
*.jfr
nacos-mysql.sql

# 代码图谱本地索引
.codegraph/
.code-review-graph/

**/__pycache__/
*.pyc

# JCode AI Agent 开发工作目录（IDE 工具配置，规范/约束/质量工具，本地不入库）
/.jcode/

# Issue tracker: 本地 Markdown 提案（见 docs/agents/issue-tracker.md）
/.scratch/

# Dry run tools (manual development verification, not part of production test suite)
**/SysUserDryRun.java
