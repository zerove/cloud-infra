# Cloud-Infra 环境变量模板
# 复制为 .env 并填入实际值，不要提交 .env 到版本控制
# 执行 ./deploy/up.sh 时若 .env 不存在会自动生成本地开发配置

# 基础设施凭据（compose 必需，与微服务 Nacos 配置中的默认值保持一致）
POSTGRES_DB=cloud_infra
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
# 微服务 Nacos 配置引用的 MQ 凭据（生产必须改强口令并与上面保持一致）
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
MINIO_ROOT_USER=minio-dev-user
MINIO_ROOT_PASSWORD=minio-dev-secret-12345678

# 数据库
SPRING_DATASOURCE_HOST=localhost
SPRING_DATASOURCE_PORT=5432
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=password

# Redis
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# Nacos
NACOS_HOST=localhost
NACOS_PORT=8848

# Gateway
GATEWAY_PORT=9000

# JWT 密钥（至少 32 字符，生产环境必须修改；缺失会导致服务拒绝启动）
AUTH_JWT_SECRET=your_very_secure_jwt_secret_key_at_least_32_chars

# 内部服务间调用签名密钥（与 JWT 同理，生产必须独立高强度值）
INTERNAL_CALL_SECRET=cloud-infra-internal-dev-secret

# 追踪采样率（生产建议 0.1 以下）
TRACE_SAMPLING_PROBABILITY=1.0

# 对象存储
MINIO_ENDPOINT=http://cloud-minio:9000
MINIO_ACCESS_KEY=minio-dev-user
MINIO_SECRET_KEY=minio-dev-secret-12345678
MINIO_BUCKET=cloud-infra

# Elasticsearch
ELASTICSEARCH_URIS=http://cloud-elasticsearch:9200

# 可观测性
OTLP_TRACING_ENDPOINT=http://otel-collector:4318/v1/traces

# JVM 参数（所有微服务统一）
JAVA_OPTS=-XX:+UseZGC -Xms256m -Xmx512m -Dspring.threads.virtual.enabled=true