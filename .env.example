# Cloud-Infra 环境变量模板
# 复制为 .env 并填入实际值，不要提交 .env 到版本控制
# 执行 ./deploy/up.sh 时若 .env 不存在会自动生成本地开发配置

# 基础设施凭据（compose 必需，与微服务 Nacos 配置中的默认值保持一致）
POSTGRES_DB=cloud_infra
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
# 微服务 Nacos 配置引用的 MQ 凭据（生产必须改强口令并与上面保持一致）
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
MINIO_ROOT_USER=minio-dev-user
MINIO_ROOT_PASSWORD=minio-dev-secret-12345678

# 数据库
SPRING_DATASOURCE_HOST=localhost
SPRING_DATASOURCE_PORT=5432
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=password

# Redis
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# Nacos
NACOS_HOST=localhost
NACOS_PORT=8848

# Gateway
GATEWAY_PORT=9000

# JWT 密钥（至少 32 字符，生产环境必须独立生成；缺失会导致服务拒绝启动）
# ⚠️ 必须留空: 写明示例值 = 把该密钥公开给所有按模板部署的环境,
#    任何读过本仓库的人都能用它伪造管理员 token。up.sh 会自动随机化本项。
AUTH_JWT_SECRET=

# Nacos 3.x 鉴权令牌, **Base64 编码且解码后 >= 32 字节**。
# 留空会导致 nacos 容器启动即 exit 255 并进入重启循环 (2026-10-17 E2E 实测)。
# up.sh 会自动随机化本项。
NACOS_AUTH_TOKEN=

# 内部服务间调用签名密钥（与 JWT 同理，生产必须独立高强度值）。
# 留空或填入公开示例值时，up.sh 与服务侧守护会拒绝/随机化，公开弱默认密钥不可用于验签。
INTERNAL_CALL_SECRET=

# 固定验证码（e2e 脚本依赖；留空则走真实验证码，生产环境务必清空）
AUTH_CAPTCHA_FIXED_CODE=

# 追踪采样率（生产建议 0.1 以下）
TRACE_SAMPLING_PROBABILITY=1.0

# 对象存储
MINIO_ENDPOINT=http://cloud-minio:9000
MINIO_ACCESS_KEY=minio-dev-user
MINIO_SECRET_KEY=minio-dev-secret-12345678
MINIO_BUCKET=cloud-infra

# Elasticsearch
ELASTICSEARCH_URIS=http://cloud-elasticsearch:9200

# 可观测性
OTLP_TRACING_ENDPOINT=http://otel-collector:4318/v1/traces

# JVM 参数兜底值。compose 中每个服务各自显式声明 JAVA_OPTS 并覆盖本项,
# 即实际运行值以 compose 为准 (G1GC + -Xmx256m)。
# 2026-10-17 更正: 此处原为 -XX:+UseZGC, 而运行态从未使用 ZGC。
JAVA_OPTS=-XX:+UseG1GC -Xms128m -Xmx256m -Dspring.threads.virtual.enabled=true