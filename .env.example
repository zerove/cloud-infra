# Cloud-Infra 环境变量模板
# 复制为 .env 并填入实际值，不要提交 .env 到版本控制

# 数据库
SPRING_DATASOURCE_HOST=localhost
SPRING_DATASOURCE_PORT=5432
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_password

# Redis
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# Nacos
NACOS_HOST=localhost
NACOS_PORT=8848

# Gateway
GATEWAY_PORT=9000

# JWT 密钥（至少 32 字符，生产环境必须修改）
AUTH_JWT_SECRET=your_very_secure_jwt_secret_key_at_least_32_chars

# JVM 参数（所有微服务统一）
JAVA_OPTS=-XX:+UseZGC -Xms256m -Xmx512m -Dspring.threads.virtual.enabled=true