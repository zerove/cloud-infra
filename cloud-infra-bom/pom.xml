<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <artifactId>cloud-infra</artifactId>
        <groupId>com.cloudinfra</groupId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>cloud-infra-bom</artifactId>
    <packaging>pom</packaging>
    <name>cloud-infra-bom</name>
    <description>Cloud-Infra Platform Bill of Materials - 统一管理平台所有依赖版本</description>

    <properties>
        <!-- 平台模块版本 -->
        <cloud-infra.version>1.0.0-SNAPSHOT</cloud-infra.version>

        <!-- 第三方依赖版本 -->
        <grpc.version>1.83.1</grpc.version>
        <protobuf.version>3.25.5</protobuf.version>
        <minio.version>8.5.7</minio.version>
        <awaitility.version>4.2.0</awaitility.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- ========== 平台内部模块 ========== -->
            <dependency>
                <groupId>com.cloudinfra</groupId>
                <artifactId>cloud-infra-common</artifactId>
                <version>${cloud-infra.version}</version>
            </dependency>
            <dependency>
                <groupId>com.cloudinfra</groupId>
                <artifactId>cloud-infra-api</artifactId>
                <version>${cloud-infra.version}</version>
            </dependency>
            <dependency>
                <groupId>com.cloudinfra</groupId>
                <artifactId>cloud-infra-starter</artifactId>
                <version>${cloud-infra.version}</version>
            </dependency>
            <dependency>
                <groupId>com.cloudinfra</groupId>
                <artifactId>cloud-infra-test-support</artifactId>
                <version>${cloud-infra.version}</version>
            </dependency>
            <dependency>
                <groupId>com.cloudinfra</groupId>
                <artifactId>framework-web</artifactId>
                <version>${cloud-infra.version}</version>
            </dependency>
            <dependency>
                <groupId>com.cloudinfra</groupId>
                <artifactId>framework-mybatis</artifactId>
                <version>${cloud-infra.version}</version>
            </dependency>
            <dependency>
                <groupId>com.cloudinfra</groupId>
                <artifactId>framework-redis</artifactId>
                <version>${cloud-infra.version}</version>
            </dependency>
            <dependency>
                <groupId>com.cloudinfra</groupId>
                <artifactId>framework-security</artifactId>
                <version>${cloud-infra.version}</version>
            </dependency>
            <dependency>
                <groupId>com.cloudinfra</groupId>
                <artifactId>framework-tracing</artifactId>
                <version>${cloud-infra.version}</version>
            </dependency>

            <!-- ========== gRPC / Protobuf ========== -->
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-stub</artifactId>
                <version>${grpc.version}</version>
            </dependency>
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-protobuf</artifactId>
                <version>${grpc.version}</version>
            </dependency>
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-netty-shaded</artifactId>
                <version>${grpc.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>${protobuf.version}</version>
            </dependency>

            <!-- ========== 存储 ========== -->
            <dependency>
                <groupId>io.minio</groupId>
                <artifactId>minio</artifactId>
                <version>${minio.version}</version>
            </dependency>

            <!-- ========== 测试 ========== -->
            <dependency>
                <groupId>org.awaitility</groupId>
                <artifactId>awaitility</artifactId>
                <version>${awaitility.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- BOM 不需要打包，仅作为依赖管理 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>3.1.4</version>
                <configuration>
                    <skip>false</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>