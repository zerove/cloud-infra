        <protoc.version>4.34.2</protoc.version>
        <grpc.version>1.80.0</grpc.version>

        <!-- Native Image Build Control -->
        <spring-boot.aot.skip>true</spring-boot.aot.skip>
        <native.image.skip>true</native.image.skip>
        <spring-boot.repackage.skip>false</spring-boot.repackage.skip>

        <!-- 测试分离控制：单测走 surefire，集成测试走 failsafe -->
        <skipUnitTests>false</skipUnitTests>
        <skipITs>true</skipITs>
    </properties>

