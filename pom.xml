                <spring-boot.build-image.env.BP_NATIVE_IMAGE>true</spring-boot.build-image.env.BP_NATIVE_IMAGE>
                <spring-boot.build-image.env.BP_JVM_VERSION>25</spring-boot.build-image.env.BP_JVM_VERSION>
                <spring-boot.build-image.publish>false</spring-boot.build-image.publish>
