<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>cloud-infra-modules</artifactId>
        <groupId>com.cloudinfra</groupId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>demo-service</artifactId>
    <packaging>jar</packaging>

    <properties>
        <main.class>com.cloudinfra.demo.DemoApplication</main.class>
    </properties>

    <dependencies>
        <!-- 平台聚合 Starter：一个依赖引入全部平台能力 -->
        <dependency>
            <groupId>com.cloudinfra</groupId>
            <artifactId>cloud-infra-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cloudinfra</groupId>
            <artifactId>cloud-infra-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cloudinfra</groupId>
            <artifactId>cloud-infra-api</artifactId>
        </dependency>
        <!-- Feign 客户端负载均衡（EnableFeignClients 必需） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.cloudinfra</groupId>
            <artifactId>cloud-infra-test-support</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
