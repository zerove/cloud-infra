<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>cloud-infra</artifactId>
        <groupId>com.cloudinfra</groupId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>cloud-infra-modules</artifactId>
    <packaging>pom</packaging>
    <name>cloud-infra-modules</name>
    <description>Business Microservices Parent</description>

    <build>
    </build>

    <modules>
        <module>system-module</module>
        <module>notification-service</module>
        <module>file-service</module>
        <module>search-service</module>
    </modules>

    <!--
      demo-service 仅作为新服务脚手架模板保留（健康检查/whoami 示例），
      不参与默认构建与测试；需要时用 -Pwith-demo 显式激活：
        mvn clean package -Pwith-demo -pl cloud-infra-modules/demo-service -am
    -->
    <profiles>
        <profile>
            <id>with-demo</id>
            <modules>
                <module>demo-service</module>
            </modules>
        </profile>
    </profiles>

</project>
