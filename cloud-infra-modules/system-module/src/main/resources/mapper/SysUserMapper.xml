<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cloudinfra.system.mapper.SysUserMapper">

    <select id="selectUserPage" resultType="com.cloudinfra.system.domain.SysUser">
        select u.user_id, u.username, u.phone, u.dept_id, u.status, u.email, 
               u.create_by, u.create_time, u.update_by, u.update_time
        from sys_user u
        <where>
            <if test="user.username != null and user.username != ''">
                <!-- 性能预警：前缀百分号会导致索引失效，建议大表迁移至 Elasticsearch -->
                AND u.username like concat('%', #{user.username}, '%')
            </if>
            ${user.params.dataScope}
        </where>
    </select>

</mapper>
