package com.cloudinfra.system.grpc;

import com.cloudinfra.api.system.grpc.UserServiceGrpc;
import com.cloudinfra.api.system.grpc.UserServiceOuterClass;
import com.cloudinfra.system.domain.SysUser;
import com.cloudinfra.system.domain.dto.SysUserCreateDTO;
import com.cloudinfra.system.domain.vo.SysUserVO;
import com.cloudinfra.system.service.ISysUserService;
import com.cloudinfra.system.service.ISysPermissionService;
import com.cloudinfra.system.converter.SysUserConverter;
import io.grpc.stub.StreamObserver;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import net.devh.boot.grpc.server.service.GrpcService;

import java.util.List;

/**
 * 用户 gRPC 服务实现
 * 提供高性能的内部服务调用接口
 */
@Slf4j
@GrpcService
@RequiredArgsConstructor
public class UserGrpcService extends UserServiceGrpc.UserServiceImplBase {

    private final ISysUserService userService;
    private final ISysPermissionService permissionService;
    private final SysUserConverter userConverter;

    @Override
    public void getUserById(UserServiceOuterClass.GetUserByIdRequest request, 
                            StreamObserver<UserServiceOuterClass.GetUserByIdResponse> responseObserver) {
        try {
            Long userId = request.getUserId();
            log.debug("gRPC 获取用户: userId={}", userId);
            
            SysUser user = userService.selectUserById(userId);
            if (user == null) {
                responseObserver.onNext(UserServiceOuterClass.GetUserByIdResponse.newBuilder()
                    .setResult(UserServiceOuterClass.Result.newBuilder()
                        .setCode(404)
                        .setMessage("用户不存在")
                        .setSuccess(false)
                        .build())
                    .build());
                responseObserver.onCompleted();
                return;
            }
            
            SysUserVO vo = new SysUserConverter().entityToVo(user);
            UserServiceOuterClass.UserDTO userDTO = convertToUserDTO(vo);
            
            responseObserver.onNext(UserServiceOuterClass.GetUserByIdResponse.newBuilder()
                .setResult(UserServiceOuterClass.Result.newBuilder()
                    .setCode(200)
                    .setMessage("成功")
                    .setSuccess(true)
                    .build())
                .setUser(userDTO)
                .build());
            responseObserver.onCompleted();
        } catch (Exception e) {
            log.error("gRPC 获取用户失败: userId={}", request.getUserId(), e);
            responseObserver.onError(e);
        }
    }

    @Override
    public void getUserByUsername(UserServiceOuterClass.GetUserByUsernameRequest request, 
                                  StreamObserver<UserServiceOuterClass.GetUserByUsernameResponse> responseObserver) {
        try {
            String username = request.getUsername();
            log.debug("gRPC 根据用户名获取用户: username={}", username);
            
            SysUser user = userService.selectUserByUsername(username);
            if (user == null) {
                responseObserver.onNext(UserServiceOuterClass.GetUserByUsernameResponse.newBuilder()
                    .setResult(UserServiceOuterClass.Result.newBuilder()
                        .setCode(404)
                        .setMessage("用户不存在")
                        .setSuccess(false)
                        .build())
                    .build());
                responseObserver.onCompleted();
                return;
            }
            
            SysUserVO vo = new SysUserConverter().entityToVo(user);
            UserServiceOuterClass.UserDTO userDTO = convertToUserDTO(vo);
            
            responseObserver.onNext(UserServiceOuterClass.GetUserByUsernameResponse.newBuilder()
                .setResult(UserServiceOuterClass.Result.newBuilder()
                    .setCode(200)
                    .setMessage("成功")
                    .setSuccess(true)
                    .build())
                .setUser(userDTO)
                .build());
            responseObserver.onCompleted();
        } catch (Exception e) {
            log.error("gRPC 根据用户名获取用户失败: username={}", request.getUsername(), e);
            responseObserver.onError(e);
        }
    }

    @Override
    public void getPermissionsByUserId(UserServiceOuterClass.GetPermissionsByUserIdRequest request, 
                                       StreamObserver<UserServiceOuterClass.GetPermissionsByUserIdResponse> responseObserver) {
        try {
            Long userId = request.getUserId();
            log.debug("gRPC 获取用户权限: userId={}", userId);
            
            List<String> permissions = userService.getPermissionsByUserId(userId);
            
            responseObserver.onNext(UserServiceOuterClass.GetPermissionsByUserIdResponse.newBuilder()
                .setResult(UserServiceOuterClass.Result.newBuilder()
                    .setCode(200)
                    .setMessage("成功")
                    .setSuccess(true)
                    .build())
                .addAllPermissions(permissions)
                .build());
            responseObserver.onCompleted();
        } catch (Exception e) {
            log.error("gRPC 获取用户权限失败: userId={}", request.getUserId(), e);
            responseObserver.onError(e);
        }
    }

    @Override
    public void registerUser(UserServiceOuterClass.RegisterUserRequest request, 
                             StreamObserver<UserServiceOuterClass.RegisterUserResponse> responseObserver) {
        try {
            UserServiceOuterClass.UserDTO userDTO = request.getUserDTO();
            log.debug("gRPC 注册用户: username={}", userDTO.getUsername());
            
            SysUserCreateDTO createDTO = new SysUserCreateDTO();
            createDTO.setUsername(userDTO.getUsername());
            createDTO.setRealName(userDTO.getRealName());
            createDTO.setEmail(userDTO.getEmail());
            createDTO.setPhone(userDTO.getPhone());
            createDTO.setAvatar(userDTO.getAvatar());
            createDTO.setStatus(userDTO.getStatus());
            createDTO.setDeptId(userDTO.getDeptId());
            createDTO.setRoleId(userDTO.getRoleId());
            
            userService.insertUser(createDTO);
            
            responseObserver.onNext(UserServiceOuterClass.RegisterUserResponse.newBuilder()
                .setResult(UserServiceOuterClass.Result.newBuilder()
                    .setCode(200)
                    .setMessage("注册成功")
                    .setSuccess(true)
                    .build())
                .build());
            responseObserver.onCompleted();
        } catch (Exception e) {
            log.error("gRPC 注册用户失败: username={}", request.getUserDTO().getUsername(), e);
            responseObserver.onError(e);
        }
    }

    /**
     * 转换 SysUserVO 到 gRPC UserDTO
     */
    private UserServiceOuterClass.UserDTO convertToUserDTO(SysUserVO vo) {
        return UserServiceOuterClass.UserDTO.newBuilder()
            .setUserId(vo.getUserId())
            .setUsername(vo.getUsername())
            .setRealName(vo.getRealName())
            .setEmail(vo.getEmail())
            .setPhone(vo.getPhone())
            .setAvatar(vo.getAvatar())
            .setStatus(vo.getStatus())
            .setDeptId(vo.getDeptId())
            .setRoleId(vo.getRoleId())
            .addAllPermissions(vo.getPermissions())
            .setCreateTime(vo.getCreateTime() != null ? vo.getCreateTime().toString() : "")
            .setUpdateTime(vo.getUpdateTime() != null ? vo.getUpdateTime().toString() : "")
            .build();
    }
}