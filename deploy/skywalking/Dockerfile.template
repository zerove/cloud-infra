# SkyWalking Agent 共享 Dockerfile 片段 (供各业务模块 include)
#
# 完整 Dockerfile 模板 (替换原 ENTRYPOINT):
#   FROM eclipse-temurin:25-jre-alpine
#   ...
#   COPY target/*-exec.jar app.jar
#   ENV JAVA_OPTS="..."
#   # SkyWalking agent (可选挂载)
#   COPY --from=apache/skywalking-java-agent:9.6.0-java17 /skywalking/agent /skywalking/agent
#   COPY deploy/skywalking/agent-entrypoint.sh /app/agent-entrypoint.sh
#   RUN chmod +x /app/agent-entrypoint.sh
#   ENTRYPOINT ["/app/agent-entrypoint.sh"]
#
# 通过 env SW_AGENT_ENABLED=true 启用, 默认 false 不影响现状

FROM eclipse-temurin:25-jre-alpine AS base
WORKDIR /app
RUN addgroup -S cloudinfra && adduser -S cloudinfra -G cloudinfra
RUN chown -R cloudinfra:cloudinfra /app
USER cloudinfra
COPY target/*-exec.jar app.jar

# JVM 内存优化 + CDS 启动加速
ENV JAVA_OPTS="-XX:+UseG1GC -Xmx320m -Xms128m -XX:+UseCompactObjectHeaders -XX:+ExitOnOutOfMemoryError -XX:+UseContainerSupport"

# SkyWalking APM agent (字节码增强, 可选启用)
# 通过 env SW_AGENT_ENABLED=true 启用, 默认 false 兼容现有部署
COPY --from=apache/skywalking-java-agent:9.6.0-java17 /skywalking/agent /skywalking/agent
COPY deploy/skywalking/agent-entrypoint.sh /app/agent-entrypoint.sh
RUN chmod +x /app/agent-entrypoint.sh

ENTRYPOINT ["/app/agent-entrypoint.sh"]
