{
  "dashboard": {
    "uid": "cloud-infra-tracing",
    "title": "Cloud-Infra Distributed Tracing",
    "tags": ["cloud-infra", "tracing", "opentelemetry", "jaeger"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Trace Throughput (spans/sec)",
        "type": "graph",
        "datasource": "Prometheus",
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(traces_received_total[1m])",
            "legendFormat": "{{instance}} - {{service}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "ops", "label": "Spans/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 2,
        "title": "Trace Latency (p50, p95, p99)",
        "type": "graph",
        "datasource": "Prometheus",
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(trace_duration_seconds_bucket[1m]))",
            "legendFormat": "p50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, rate(trace_duration_seconds_bucket[1m]))",
            "legendFormat": "p95",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, rate(trace_duration_seconds_bucket[1m]))",
            "legendFormat": "p99",
            "refId": "C"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Trace Duration"},
          {"format": "short"}
        ]
      },
      {
        "id": 3,
        "title": "Error Traces Rate",
        "type": "graph",
        "datasource": "Prometheus",
        "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(traces_received_total{span_status=\"error\"}[1m])",
            "legendFormat": "{{service}} - error traces",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "ops", "label": "Error Traces/sec"},
          {"format": "short"}
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": {"params": [0.01], "type": "gt"},
              "operator": {"type": "and"},
              "query": {"params": ["A", "5m", "now"]},
              "reducer": {"params": [], "type": "avg"},
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "for": "2m",
          "frequency": "1m",
          "handler": 1,
          "name": "High Error Trace Rate",
          "noDataState": "no_data",
          "notifications": []
        }
      },
      {
        "id": 4,
        "title": "Service Dependency Map (Top Operations)",
        "type": "table",
        "datasource": "Prometheus",
        "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "topk(20, sum by (service, operation) (rate(span_duration_seconds_sum[5m])))",
            "format": "table",
            "refId": "A"
          }
        ],
        "transform": "table",
        "columns": [
          {"text": "Service", "value": "service"},
          {"text": "Operation", "value": "operation"},
          {"text": "Avg Duration (ms)", "value": "Value", "type": "number"}
        ]
      },
      {
        "id": 5,
        "title": "Span Kind Distribution",
        "type": "piechart",
        "datasource": "Prometheus",
        "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum by (span_kind) (rate(traces_received_total[5m]))",
            "legendFormat": "{{span_kind}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "options": {"SERVER": {"text": "Server (Inbound)"}, "CLIENT": {"text": "Client (Outbound)"}, "PRODUCER": {"text": "Producer (MQ)"}, "CONSUMER": {"text": "Consumer (MQ)"}, "INTERNAL": {"text": "Internal"}}}
            ]
          }
        }
      },
      {
        "id": 6,
        "title": "Sampling Rate Effectiveness",
        "type": "graph",
        "datasource": "Prometheus",
        "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(otlp_spans_exported_total[1m]) / rate(otlp_spans_created_total[1m]) * 100",
            "legendFormat": "{{service}} - export %",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "percentunit", "label": "Export Rate %"},
          {"format": "short"}
        ]
      },
      {
        "id": 7,
        "title": "OTel Collector Queue & Batch",
        "type": "graph",
        "datasource": "Prometheus",
        "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "otelcol_exporter_queue_size",
            "legendFormat": "{{exporter}} - queue size",
            "refId": "A"
          },
          {
            "expr": "otelcol_exporter_send_failed_spans_total",
            "legendFormat": "{{exporter}} - failed",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Queue / Failed"},
          {"format": "short"}
        ]
      },
      {
        "id": 8,
        "title": "Trace Sampling Decision",
        "type": "stat",
        "datasource": "Prometheus",
        "gridPos": {"x": 12, "y": 24, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum(rate(traces_received_total[5m])) by (service) / sum(rate(traces_started_total[5m])) by (service) * 100",
            "legendFormat": "{{service}} - sampling %",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": null},
                {"color": "yellow", "value": 50},
                {"color": "green", "value": 95}
              ]
            }
          }
        }
      }
    ],
    "templating": {
      "list": [
        {
          "name": "service",
          "type": "query",
          "datasource": "Prometheus",
          "query": "label_values(traces_received_total, service)",
          "refresh": 1,
          "includeAll": true,
          "multi": true
        }
      ]
    }
  },
  "overwrite": true
}