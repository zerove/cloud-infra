{
  "dashboard": {
    "uid": "cloud-infra-logging",
    "title": "Cloud-Infra Logs & Audit",
    "tags": ["cloud-infra", "logs", "loki", "audit"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Log Volume (lines/sec)",
        "type": "graph",
        "datasource": "Loki",
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum by (service) (rate({service=~\".+\} |= `` [1m]))",
            "legendFormat": "{{service}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "ops", "label": "Lines/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 2,
        "title": "Error Log Rate",
        "type": "graph",
        "datasource": "Loki",
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum by (service) (rate({service=~\".+\} |= \"ERROR\" [1m]))",
            "legendFormat": "{{service}} - ERROR",
            "refId": "A"
          },
          {
            "expr": "sum by (service) (rate({service=~\".+\} |= \"WARN\" [1m]))",
            "legendFormat": "{{service}} - WARN",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "ops", "label": "Logs/sec"},
          {"format": "short"}
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": {"params": [10], "type": "gt"},
              "operator": {"type": "and"},
              "query": {"params": ["A", "5m", "now"]},
              "reducer": {"params": [], "type": "avg"},
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "for": "2m",
          "frequency": "1m",
          "handler": 1,
          "name": "High Error Log Rate",
          "noDataState": "no_data",
          "notifications": []
        }
      },
      {
        "id": 3,
        "title": "Log Level Distribution",
        "type": "piechart",
        "datasource": "Loki",
        "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum by (level) (count_over_time({service=~\".+\} [5m]))",
            "legendFormat": "{{level}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "options": {"ERROR": {"color": "red", "text": "ERROR"}, "WARN": {"color": "yellow", "text": "WARN"}, "INFO": {"color": "green", "text": "INFO"}, "DEBUG": {"color": "blue", "text": "DEBUG"}, "TRACE": {"color": "purple", "text": "TRACE"}}}
            ]
          }
        }
      },
      {
        "id": 4,
        "title": "Recent Error Logs",
        "type": "logs",
        "datasource": "Loki",
        "gridPos": {"x": 12, "y": 8, "w": 12, "h": 16},
        "targets": [
          {
            "expr": "{service=~\".+\"} |= \"ERROR\"",
            "legendFormat": "{{service}} - {{instance}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "lineWidth": 1,
              "maxLines": 100,
              "showTime": true,
              "showLabels": true,
              "sortOrder": "Descending",
              "wrap": true
            }
          }
        }
      },
      {
        "id": 5,
        "title": "Audit Trail - Login Events",
        "type": "table",
        "datasource": "Loki",
        "gridPos": {"x": 0, "y": 16, "w": 24, "h": 8},
        "targets": [
          {
            "expr": "{service=~\".+\"} |= \"login\" | json",
            "legendFormat": "",
            "refId": "A"
          }
        ],
        "transform": "table",
        "columns": [
          {"text": "Time", "value": "Time"},
          {"text": "Service", "value": "service"},
          {"text": "Level", "value": "level"},
          {"text": "User", "value": "username"},
          {"text": "IP", "value": "clientIp"},
          {"text": "Status", "value": "status"},
          {"text": "Message", "value": "message"}
        ]
      },
      {
        "id": 6,
        "title": "Slow Query / Slow API Logs",
        "type": "logs",
        "datasource": "Loki",
        "gridPos": {"x": 0, "y": 24, "w": 24, "h": 8},
        "targets": [
          {
            "expr": "{service=~\".+\"} |= \"slow\" |~ \"(?i)(slow|timeout|latency)\"",
            "legendFormat": "{{service}} - {{instance}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "lineWidth": 1,
              "maxLines": 50,
              "showTime": true,
              "showLabels": true,
              "sortOrder": "Descending",
              "wrap": true
            }
          }
        }
      },
      {
        "id": 7,
        "title": "Service Health by Log Pattern",
        "type": "stat",
        "datasource": "Loki",
        "gridPos": {"x": 0, "y": 32, "w": 24, "h": 8},
        "targets": [
          {
            "expr": "sum by (service) (rate({service=~\".+\"} [5m]))",
            "legendFormat": "{{service}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": null},
                {"color": "green", "value": 1}
              ]
            },
            "unit": "reqps"
          }
        }
      }
    ],
    "templating": {
      "list": [
        {
          "name": "service",
          "type": "query",
          "datasource": "Loki",
          "query": "label_values({service=~\".+\"}, service)",
          "refresh": 1,
          "includeAll": true,
          "multi": true
        },
        {
          "name": "level",
          "type": "query",
          "datasource": "Loki",
          "query": "label_values({service=~\".+\"}, level)",
          "refresh": 1,
          "includeAll": true,
          "multi": true
        }
      ]
    }
  },
  "overwrite": true
}