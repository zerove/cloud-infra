# Stage 1: Build
FROM eclipse-temurin:25-jdk-jammy AS builder
WORKDIR /app

# Cache dependencies
COPY pom.xml .
COPY cloud-infra-api/pom.xml cloud-infra-api/
COPY cloud-infra-auth/pom.xml cloud-infra-auth/
COPY cloud-infra-common/pom.xml cloud-infra-common/
COPY cloud-infra-framework/pom.xml cloud-infra-framework/
COPY cloud-infra-gateway/pom.xml cloud-infra-gateway/
COPY cloud-infra-modules/pom.xml cloud-infra-modules/
COPY cloud-infra-starter/pom.xml cloud-infra-starter/
COPY cloud-infra-test-support/pom.xml cloud-infra-test-support/

# Build and copy sources
COPY . .
RUN ./mvnw clean package -DskipTests

# Stage 2: Runtime
FROM eclipse-temurin:25-jre-jammy
WORKDIR /app

RUN groupadd -g 1000 appuser &&     useradd -u 1000 -g appuser -m appuser

# Copy JAR from builder (dynamic path support needs to be handled in build command or env)
# Since the build command injects JAR_FILE, we will stick to the existing approach 
# of copying from host, but upgrade the image to be multi-stage compatible if needed.
# Actually, the best approach is to copy the specific JAR provided.
ARG JAR_FILE
COPY  app.jar

RUN chown appuser:appuser app.jar
USER appuser

ENV TZ=Asia/Shanghai
ENV JAVA_OPTS="-XX:MaxRAMPercentage=75.0 -XX:+UseSerialGC -Djava.security.egd=file:/dev/./urandom"

ENTRYPOINT ["sh", "-c", "java ${JAVA_OPTS} -jar app.jar"]
