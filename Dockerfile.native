# 使用轻量级的基础镜像
FROM ubuntu:24.04

# 安装运行 Native 镜像所需的最小依赖 (如 glibc, zlib)
RUN apt-get update && apt-get install -y \
    ca-certificates \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# 创建非 root 用户以提高安全性
RUN useradd -ms /bin/bash clouduser
USER clouduser
WORKDIR /app

# 拷贝 Native 二进制文件
COPY cloud-infra-gateway-binary /app/gateway
COPY cloud-infra-auth-binary /app/auth

# 默认启动 Gateway (部署时会通过 K8s 覆盖启动命令)
ENTRYPOINT ["/app/gateway"]
